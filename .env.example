# Runtime (Cloudflare Worker / astro dev) — nunca commite valores reais.
# Local: use `doppler run -- npm run dev` ou crie .dev.vars (gitignore).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_SEGMENT_ID=00000000-0000-0000-0000-000000000000
NEWSLETTER_FROM="introducing.news <oi@introducing.news>"

# Site
SITE_URL=https://introducing.news

# Cloudflare Turnstile (CAPTCHA da inscrição)
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Opcional — Keystatic em modo GitHub (edição pela web / CMS em produção)
# Crie um GitHub App e preencha; sem isso o CMS roda em modo local (dev).
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=            # string aleatória com 32+ caracteres
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
