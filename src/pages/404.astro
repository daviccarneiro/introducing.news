---
import Base from '../layouts/Base.astro';
import { t } from '../copy';
---

<Base title={`${t('notfound.title')} · introducing.news`} description={t('notfound.body')} noindex>
  <section class="nf container">
    <p class="nf__code">404</p>
    <h1>{t('notfound.title')}</h1>
    <p class="nf__body">{t('notfound.body')}</p>
    <div class="nf__actions">
      <a class="nf__button" href="/">{t('notfound.home')}</a>
      <a class="nf__link" href="/arquivo/">{t('notfound.archive')}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-24) var(--space-32);
  }

  .nf__code {
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  .nf h1 {
    font: 600 clamp(32px, 4.5vw, 44px) / 1.12 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .nf__body {
    font: 400 18px/1.6 var(--font-serif);
    color: var(--muted-foreground);
    max-width: 560px;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .nf__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding-inline: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-foreground);
    font: 600 15px/1.2 var(--font-sans);
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .nf__button:hover {
    background: var(--accent-600);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .nf__link {
    font: 500 14px/1.4 var(--font-sans);
    color: var(--link);
  }
</style>
