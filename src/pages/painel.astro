---
export const prerender = false;

import { timingSafeEqual, createHash } from 'node:crypto';
import { DASHBOARD_PASSWORD, RESEND_API_KEY, RESEND_SEGMENT_ID } from 'astro:env/server';
import { clientIp, isRateLimited } from '../lib/api';
import { dashboardData, type DayRow } from '../lib/dashboard';

/**
 * Painel de métricas (privado). Basic Auth com `DASHBOARD_PASSWORD`
 * (qualquer usuário); sem a env, a rota responde 404. Erros de senha contam
 * no rate limit por IP (10 a cada 15 min) e bloqueiam até a janela passar.
 */
const { request, url } = Astro;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

if (!DASHBOARD_PASSWORD || !RESEND_API_KEY || !RESEND_SEGMENT_ID) {
  return new Response('Not found', { status: 404 });
}

const LOCK = { scope: 'painel-auth', max: 10, windowSeconds: 900 };
const ip = clientIp(request);
if (await isRateLimited(ip, LOCK.scope, LOCK.max, LOCK.windowSeconds, true)) {
  return new Response('Muitas tentativas. Tente mais tarde.', {
    status: 429,
    headers: { 'Retry-After': String(LOCK.windowSeconds) },
  });
}

const digest = (value: string) => createHash('sha256').update(value).digest();
const header = request.headers.get('authorization') ?? '';
let password = '';
if (header.startsWith('Basic ')) {
  try {
    const decoded = atob(header.slice(6));
    password = decoded.slice(decoded.indexOf(':') + 1);
  } catch {
    password = '';
  }
}
if (!password || !timingSafeEqual(digest(password), digest(DASHBOARD_PASSWORD))) {
  if (password) await isRateLimited(ip, LOCK.scope, LOCK.max, LOCK.windowSeconds);
  return new Response('Acesso restrito.', {
    status: 401,
    headers: {
      'WWW-Authenticate': 'Basic realm="introducing.news painel", charset="UTF-8"',
      'Cache-Control': 'no-store',
    },
  });
}

const PERIODS = [7, 30, 90] as const;
const requested = Number(url.searchParams.get('p'));
const period = (PERIODS as readonly number[]).includes(requested) ? requested : 30;
const refresh = url.searchParams.has('atualizar');

let data: Awaited<ReturnType<typeof dashboardData>> | null = null;
let failure = '';
try {
  data = await dashboardData(period, refresh);
} catch (error) {
  console.error('painel: falha ao montar dados', error);
  failure = 'Não foi possível ler os dados do Resend agora. Tente atualizar em instantes.';
}

// --- Formatação --------------------------------------------------------------

const int = new Intl.NumberFormat('pt-BR');
const pct = (value: number | null, digits = 1) =>
  value == null ? '—' : `${(value * 100).toLocaleString('pt-BR', { maximumFractionDigits: digits, minimumFractionDigits: 0 })}%`;
const signed = (value: number) => (value > 0 ? `+${int.format(value)}` : int.format(value));
const dayLabel = (day: string, style: 'short' | 'long' = 'short') =>
  new Date(`${day}T12:00:00-03:00`).toLocaleDateString('pt-BR', {
    day: 'numeric',
    month: style === 'short' ? 'short' : 'long',
    timeZone: 'America/Sao_Paulo',
    ...(style === 'long' ? { weekday: 'short' } : {}),
  });
const ago = (iso: string) => {
  const minutes = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60000));
  return minutes < 1 ? 'agora' : minutes < 60 ? `há ${minutes} min` : `há ${Math.round(minutes / 60)} h`;
};

/** Variação contra o período anterior: texto + se a direção é boa. */
const delta = (current: number | null, previous: number | null, upIsGood = true, asPoints = false) => {
  if (current == null || previous == null) return null;
  const diff = current - previous;
  if (Math.abs(diff) < 1e-9) return { text: 'igual ao período anterior', tone: 'flat' };
  const text = asPoints
    ? `${diff > 0 ? '+' : '−'}${(Math.abs(diff) * 100).toLocaleString('pt-BR', { maximumFractionDigits: 1 })} p.p.`
    : `${diff > 0 ? '+' : '−'}${int.format(Math.abs(diff))}`;
  return { text: `${text} vs ${period} dias anteriores`, tone: diff > 0 === upIsGood ? 'good' : 'bad' };
};

// --- Gráficos (SVG no servidor) -----------------------------------------------

const W = 340;
const PAD = { top: 10, right: 4, bottom: 18, left: 28 };
const plotW = W - PAD.left - PAD.right;

/** Coluna com ponta arredondada (4px) e base reta. */
const column = (x: number, width: number, base: number, height: number, up: boolean) => {
  if (height <= 0) return '';
  const r = Math.min(4, width / 2, height);
  const end = up ? base - height : base + height;
  const dir = up ? 1 : -1;
  return [
    `M${x},${base}`,
    `V${end + dir * r}`,
    `Q${x},${end} ${x + r},${end}`,
    `H${x + width - r}`,
    `Q${x + width},${end} ${x + width},${end + dir * r}`,
    `V${base}Z`,
  ].join(' ');
};

const niceMax = (value: number) => {
  if (value <= 4) return Math.max(1, Math.ceil(value));
  const magnitude = 10 ** Math.floor(Math.log10(value));
  const step = [1, 2, 2.5, 5, 10].find((s) => s * magnitude >= value / 2) ?? 10;
  return Math.ceil(value / (step * magnitude)) * step * magnitude;
};

const band = (rows: DayRow[]) => {
  const slot = plotW / Math.max(rows.length, 1);
  const width = Math.max(1, Math.min(24, slot - 2));
  return { slot, width, offset: (slot - width) / 2 };
};

/** Rótulos do eixo x: primeiro, meio e último dia. */
const xTicks = (rows: DayRow[]) => {
  if (!rows.length) return [];
  const { slot } = band(rows);
  const picks = [...new Set([0, Math.floor((rows.length - 1) / 2), rows.length - 1])];
  return picks.map((index) => ({
    x: PAD.left + slot * index + slot / 2,
    label: dayLabel(rows[index]!.day),
    anchor: index === 0 ? 'start' : index === rows.length - 1 ? 'end' : 'middle',
  }));
};

const flowChart = (rows: DayRow[]) => {
  const H = 170;
  const plotH = H - PAD.top - PAD.bottom;
  const maxUp = niceMax(Math.max(...rows.map((row) => row.signups + row.resubscribes), 1));
  const maxDown = Math.max(...rows.map((row) => row.unsubscribes), 0);
  const down = maxDown > 0 ? niceMax(maxDown) : 0;
  const range = maxUp + down;
  const base = PAD.top + (plotH * maxUp) / range;
  const scale = plotH / range;
  const { slot, width, offset } = band(rows);
  return {
    H,
    base,
    ticks: [
      { y: PAD.top, label: int.format(maxUp) },
      { y: base, label: '0' },
      ...(down ? [{ y: PAD.top + plotH, label: `−${int.format(down)}` }] : []),
    ],
    bars: rows.map((row, index) => {
      const x = PAD.left + slot * index + offset;
      return {
        row,
        hitX: PAD.left + slot * index,
        up: column(x, width, base - 1, (row.signups + row.resubscribes) * scale, true),
        down: column(x, width, base + 1, row.unsubscribes * scale, false),
      };
    }),
    slot,
  };
};

const visitsChart = (rows: DayRow[]) => {
  const H = 130;
  const plotH = H - PAD.top - PAD.bottom;
  const max = niceMax(Math.max(...rows.map((row) => row.visits), 1));
  const base = PAD.top + plotH;
  const { slot, width, offset } = band(rows);
  return {
    H,
    base,
    ticks: [
      { y: PAD.top, label: int.format(max) },
      { y: PAD.top + plotH / 2, label: int.format(max / 2) },
      { y: base, label: '0' },
    ],
    bars: rows.map((row, index) => ({
      row,
      hitX: PAD.left + slot * index,
      path: column(PAD.left + slot * index + offset, width, base, (row.visits / max) * plotH, true),
    })),
    slot,
  };
};

const flow = data ? flowChart(data.rows) : null;
const visits = data ? visitsChart(data.rows) : null;
const ticksX = data ? xTicks(data.rows) : [];

const rowJson = (row: DayRow) =>
  JSON.stringify({
    d: dayLabel(row.day, 'long'),
    s: row.signups,
    r: row.resubscribes,
    u: row.unsubscribes,
    v: row.visits,
    c: row.visits > 0 ? pct(row.signups / row.visits) : '—',
  });

const t = data?.totals;
const prev = data?.previous;
const latest = data?.snapshot.editions[0];
const rate = (value: number, total: number) => (total > 0 ? value / total : null);
const maxSource = (list: { count: number }[]) => Math.max(...list.map((item) => item.count), 1);
const shortUrl = (value: string) => {
  try {
    const parsed = new URL(value);
    return `${parsed.hostname.replace(/^www\./, '')}${parsed.pathname === '/' ? '' : parsed.pathname}`;
  } catch {
    return value;
  }
};
