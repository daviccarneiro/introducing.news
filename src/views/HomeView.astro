---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { t } from '../copy';
import { formatDate, getAuthor, getPosts, initialsOf, readingTime } from '../lib/posts';

const posts = await getPosts();
const [featured] = posts;
const featuredHref = featured ? `/arquivo/${featured.id}/` : '/';
const featuredAuthor = featured ? await getAuthor(featured) : null;
const faqs = [
  { q: t('home.faq.q1'), a: t('home.faq.a1') },
  { q: t('home.faq.q2'), a: t('home.faq.a2') },
  { q: t('home.faq.q3'), a: t('home.faq.a3') },
  { q: t('home.faq.q4'), a: t('home.faq.a4') },
  { q: t('home.faq.q5'), a: t('home.faq.a5') },
];
---

<Base>
  <section class="hero container" id="assinar">
    <h1>
      {t('home.title.line1')}<br />
      <span class="mark">
        <img class="mark__bg" src="/images/highlight.svg" width="363" height="56" alt="" aria-hidden="true" />
        <span class="mark__text">{t('home.title.line2')}</span>
      </span>
    </h1>
    <p class="hero__sub">{t('home.sub')}</p>
    <SubscribeForm id="assinar-form" />
    <p class="meta">{t('home.micro')}</p>
  </section>

  {
    featured && (
      <section class="featured">
        <div class="container">
          <div class="section-head">
            <h2>{t('home.latest.title')}</h2>
            <a class="button button--secondary" href="/arquivo/">{t('home.seeAll')}</a>
          </div>

          <article class="featured__card">
            <div class="featured__body">
              <h3 class="featured__title">
                <a href={featuredHref}>{featured.data.title}</a>
              </h3>
              <p class="featured__lead">{featured.data.description}</p>
              {
                featuredAuthor && (
                  <div class="featured__author">
                    {featuredAuthor.data.photo ? (
                      <img
                        class="avatar avatar--photo"
                        src={featuredAuthor.data.photo}
                        alt=""
                        width="40"
                        height="40"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="avatar" aria-hidden="true">
                        {initialsOf(featuredAuthor.data.name)}
                      </span>
                    )}
                    <div class="featured__author-info">
                      <p class="featured__name">{featuredAuthor.data.name}</p>
                      <p class="meta featured__byline">
                        <span class="featured__date">{formatDate(featured.data.publishedAt)}</span>
                        <span aria-hidden="true">·</span>
                        <span>{readingTime(featured)} {t('post.minRead')}</span>
                      </p>
                    </div>
                  </div>
                )
              }
              <a class="link-arrow" href={featuredHref}>
                {t('home.latest.link')}
                <img src="/icons/arrow-right.svg" width="16" height="16" alt="" aria-hidden="true" />
              </a>
            </div>
            <a class="featured__cover" href={featuredHref} tabindex="-1" aria-hidden="true">
              <Cover variant={featured.data.cover} src={featured.data.coverImage} />
            </a>
          </article>
        </div>
      </section>
    )
  }

  <section class="cta container">
    <div class="cta__band">
      <div class="cta__content">
        <h2>{t('home.cta.title')}</h2>
        <p>{t('home.cta.body')}</p>
        <div class="cta__actions">
          <a
            class="button button--accent"
            href="https://www.linkedin.com/in/daviccarneiro/"
            target="_blank"
            rel="noopener"
          >
            {t('home.cta.linkedin')}
            <img src="/icons/arrow-right-accent.svg" width="16" height="16" alt="" aria-hidden="true" />
          </a>
          <a class="button button--ghost-inverse" href="/arquivo/">{t('home.cta.browse')}</a>
        </div>
      </div>
      <img class="cta__doodle" src="/icons/sparkle.svg" width="40" height="40" alt="" aria-hidden="true" />
    </div>
  </section>

  <section class="faq container" id="faq">
    <h2>{t('home.faq.title')}</h2>
    <div class="faq__list">
      {
        faqs.map((item) => (
          <details class="faq__item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-24) var(--space-20);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .hero h1 {
    font: 600 clamp(40px, 5.5vw, 64px) / 1.05 var(--font-serif);
    letter-spacing: -0.015em;
    max-width: 900px;
  }

  .mark {
    position: relative;
    display: inline-block;
  }

  .mark__bg {
    position: absolute;
    left: -2px;
    top: 50%;
    width: calc(100% + 8px);
    max-width: none;
    height: 0.875em;
    transform: translateY(-50%) rotate(1.2deg);
    clip-path: inset(0 100% 0 0);
    animation: mark-sweep 0.5s ease-out 1s forwards;
  }

  @keyframes mark-sweep {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark__bg {
      clip-path: none;
      animation: none;
    }
  }

  .mark__text {
    position: relative;
  }

  .hero__sub {
    font: 400 16px/1.6 var(--font-sans);
    color: var(--muted-foreground);
    max-width: 620px;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-6);
  }

  .section-head h2 {
    font: 600 28px/1.22 var(--font-serif);
    letter-spacing: -0.01em;
  }

  .featured {
    background: var(--muted);
    padding-block: var(--space-16) var(--space-20);
  }

  .featured__card {
    display: grid;
    gap: 0;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .featured__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-10);
  }

  .featured__title {
    min-width: 0;
    font: 600 clamp(30px, 3.2vw, 44px) / 1.3 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .featured__title a {
    text-decoration: none;
  }

  .featured__lead {
    font: 400 21px/1.65 var(--font-serif);
    color: var(--muted-foreground);
    max-width: 542px;
  }

  .featured__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .featured__author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .featured__name {
    font: 500 17px/1.4 var(--font-sans);
  }

  .featured__byline {
    display: flex;
    gap: var(--space-1);
  }

  .featured__date {
    text-transform: uppercase;
  }

  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent-soft-foreground);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
  }

  .avatar--photo {
    object-fit: cover;
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2);
    font: 500 14px/1.4 var(--font-sans);
    color: var(--link);
    text-decoration: none;
  }

  .cta {
    padding-block: var(--space-20) var(--space-6);
  }

  .cta__band {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    background: var(--primary);
    color: var(--primary-foreground);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
  }

  .cta__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 560px;
  }

  .cta__content h2 {
    font: 600 28px/1.22 var(--font-serif);
    letter-spacing: -0.01em;
  }

  .cta__content p {
    color: var(--ink-400);
    max-width: 460px;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    font: 500 14px/1.4 var(--font-sans);
    text-decoration: none;
  }

  .button--secondary {
    height: 40px;
    padding-inline: var(--space-4);
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
  }

  .button--accent {
    height: 48px;
    padding-inline: var(--space-5);
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 15px;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .button--accent:hover {
    background: var(--accent-600);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .button--ghost-inverse {
    height: 40px;
    padding-inline: var(--space-4);
    color: var(--primary-foreground);
  }

  .faq {
    padding-block: var(--space-16) var(--space-20);
  }

  .faq h2 {
    font: 600 28px/1.22 var(--font-serif);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-8);
  }

  .faq__list {
    border-top: 1px solid var(--border);
  }

  .faq__item {
    border-bottom: 1px solid var(--border);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
    font: 500 17px/1.4 var(--font-sans);
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    font: 400 20px/1 var(--font-mono);
    color: var(--muted-foreground);
    transition: transform 0.15s ease;
  }

  .faq__item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq__item p {
    font: 400 15px/1.65 var(--font-sans);
    color: var(--muted-foreground);
    max-width: 640px;
    padding-bottom: var(--space-5);
  }

  @media (min-width: 768px) {
    .cta__band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-12);
      padding: var(--space-16);
    }
  }

  @media (min-width: 1000px) {
    .featured__card {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .section-head .button--secondary {
      height: 36px;
      font-size: 13px;
      padding-inline: var(--space-3);
      white-space: nowrap;
    }
  }
</style>
