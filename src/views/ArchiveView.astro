---
import Base from '../layouts/Base.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { t } from '../copy';
import { formatDate, getPosts, readingTime } from '../lib/posts';

const posts = await getPosts();
---

<Base title={t('meta.archive.title')} description={t('meta.archive.description')}>
  <section class="head container">
    <h1>{t('archive.title')}</h1>
    <p class="head__sub">{t('archive.sub')}</p>
  </section>

  <section class="list container">
    {
      posts.map((post) => (
        <a class="row" href={`/arquivo/${post.id}/`}>
          <div class="row__meta">
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
            <span>
              {readingTime(post)} {t('post.minRead')}
            </span>
          </div>
          <div class="row__body">
            <h2>{post.data.title}</h2>
            <p class="row__excerpt">{post.data.description}</p>
          </div>
          <img class="row__arrow" src="/icons/arrow-right.svg" width="20" height="20" alt="" aria-hidden="true" />
        </a>
      ))
    }
    {posts.length === 0 && <p class="list__empty meta">{t('archive.empty')}</p>}
  </section>

  <section class="subscribe-band container">
    <div class="subscribe-band__inner">
      <div>
        <h2>{t('archive.band.title')}</h2>
        <p class="subscribe-band__body">{t('archive.band.body')}</p>
      </div>
      <SubscribeForm id="assinar-arquivo" compact />
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: var(--space-16) var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .head h1 {
    font: 600 clamp(34px, 4.5vw, 44px) / 1.12 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .head__sub {
    font: 400 16px/1.6 var(--font-sans);
    color: var(--muted-foreground);
    max-width: 640px;
  }

  .list {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-4) var(--space-6);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .row:hover {
    background: var(--muted);
  }

  .row__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font: 400 13px/1.4 var(--font-sans);
    color: var(--muted-foreground);
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .row h2 {
    min-width: 0;
    font: 600 21px/1.3 var(--font-serif);
    letter-spacing: -0.005em;
  }

  .row__excerpt {
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
    max-width: 700px;
  }

  .row__arrow {
    display: none;
  }

  .subscribe-band {
    padding-block: var(--space-6) var(--space-20);
  }

  .subscribe-band__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    justify-content: space-between;
    background: var(--muted);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
  }

  .subscribe-band__inner h2 {
    font: 600 28px/1.22 var(--font-serif);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-1);
  }

  .subscribe-band__body {
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
  }

  @media (min-width: 768px) {
    .row {
      grid-template-columns: 150px minmax(0, 1fr) 20px;
      align-items: center;
      gap: var(--space-8);
      min-height: 56px;
      padding-block: 0;
    }

    .row__arrow {
      display: block;
      justify-self: end;
    }

    .subscribe-band__inner {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
