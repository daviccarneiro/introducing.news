---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Cover from '../components/Cover.astro';
import PostCard from '../components/PostCard.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { OTHER, paths, type Locale } from '../i18n/config';
import { categoryLabel, useTranslations } from '../i18n/ui';
import { formatDate, getPosts, getTranslation, readingTime, slugOf, type Post } from '../lib/posts';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const { Content } = await render(post);
const t = useTranslations(locale);
const translation = await getTranslation(post, locale);
const alternate = translation
  ? paths.post(OTHER[locale], slugOf(translation))
  : paths.archive(OTHER[locale]);
const related = (await getPosts(locale)).filter((entry) => entry.id !== post.id).slice(0, 2);
const postUrl = new URL(paths.post(locale, slugOf(post)), Astro.site ?? Astro.url).href;
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;
---

<Base title={`${post.data.title} — introducing.news`} description={post.data.description} alternate={alternate} type="article">
  <article>
    <header class="post-head container">
      <a class="post-head__back meta" href={paths.archive(locale)}>{t('post.back')}</a>
      <div class="post-head__meta">
        <Badge tone="accent">{categoryLabel(t, post.data.category)}</Badge>
        <span class="meta">{formatDate(post.data.publishedAt, locale)}</span>
        {
          translation && (
            <a class="post-head__lang meta" href={paths.post(OTHER[locale], slugOf(translation))}>
              {t('post.readOther')}
            </a>
          )
        }
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-head__lead">{post.data.description}</p>
      <div class="post-head__author">
        <span class="avatar" aria-hidden="true">DC</span>
        <div>
          <p class="post-head__name">Davi Carneiro</p>
          <p class="meta">{readingTime(post)} {t('post.minRead')}</p>
        </div>
      </div>
    </header>

    <div class="post-cover container">
      <Cover variant={post.data.cover} class="post-cover__art" />
    </div>

    <div class="post-body container">
      <div class="prose">
        <Content />
      </div>

      <div class="post-share">
        <p>{t('post.like')}</p>
        <div class="post-share__actions">
          <button class="button button--secondary" type="button" data-copy-link data-copied={t('post.copied')}>
            {t('post.copy')}
            <span aria-hidden="true">↗</span>
          </button>
          <a class="button button--primary" href={linkedinShare} target="_blank" rel="noopener">
            {t('post.share')}
            <span aria-hidden="true">in</span>
          </a>
        </div>
      </div>

      <div class="post-subscribe">
        <div>
          <h2>{t('post.subscribe.title')}</h2>
          <p class="meta">{t('post.subscribe.body')}</p>
        </div>
        <SubscribeForm id={`assinar-post-${locale}`} compact />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="continue container">
        <h2>{t('post.continue')}</h2>
        <div class="continue__grid">
          {related.map((entry) => (
            <PostCard post={entry} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  document.querySelectorAll('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const label = button.firstChild;
      if (!label) return;
      const original = label.textContent ?? '';
      try {
        await navigator.clipboard.writeText(window.location.href);
        label.textContent = button.dataset.copied ?? original;
      } catch {
        /* clipboard indisponível */
      }
      window.setTimeout(() => {
        label.textContent = original;
      }, 2000);
    });
  });
</script>

<style>
  .post-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
    padding-block: var(--space-16) var(--space-12);
  }

  .post-head__back {
    align-self: flex-start;
    text-decoration: none;
    text-transform: uppercase;
  }

  .post-head__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .post-head__lang {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--link);
  }

  .post-head h1 {
    font: 600 clamp(30px, 4vw, 40px) / 1.12 var(--font-sans);
    letter-spacing: -0.02em;
    max-width: 720px;
  }

  .post-head__lead {
    font: 400 21px/1.65 var(--font-serif);
    color: var(--muted-foreground);
    max-width: 640px;
  }

  .post-head__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-align: left;
  }

  .post-head__name {
    font: 500 17px/1.4 var(--font-sans);
  }

  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent-soft-foreground);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
  }

  .post-cover {
    margin-bottom: var(--space-16);
  }

  .post-cover__art {
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }

  .post-body .prose {
    width: 100%;
    max-width: var(--reading);
  }

  .post-share {
    width: 100%;
    max-width: var(--reading);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: 1px solid var(--border);
    padding-top: var(--space-8);
  }

  .post-share p {
    font: 500 17px/1.4 var(--font-sans);
  }

  .post-share__actions {
    display: flex;
    gap: var(--space-3);
  }

  .post-subscribe {
    width: 100%;
    max-width: var(--reading);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background: var(--muted);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .post-subscribe h2 {
    font: 600 20px/1.35 var(--font-sans);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-1);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 40px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
    font: 500 14px/1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
  }

  .button--primary {
    background: var(--primary);
    color: var(--primary-foreground);
    border: 0;
  }

  .button--secondary {
    background: var(--card);
    color: var(--foreground);
    border: 1px solid var(--border);
  }

  .continue {
    padding-block: var(--space-16) var(--space-20);
  }

  .continue h2 {
    font: 600 26px/1.25 var(--font-sans);
    letter-spacing: -0.015em;
    margin-bottom: var(--space-6);
  }

  .continue__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .post-subscribe {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .continue__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
