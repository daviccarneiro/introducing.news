---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import PostCard from '../components/PostCard.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { t } from '../copy';
import { getAuthor, getPosts, initialsOf, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = (await getPosts()).filter((entry) => entry.id !== post.id).slice(0, 2);
const postUrl = new URL(`/arquivo/${post.id}/`, Astro.site ?? Astro.url).href;
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;
const whatsappShare = `https://wa.me/?text=${encodeURIComponent(`${post.data.title} ${postUrl}`)}`;
const xShare = `https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`;
const author = await getAuthor(post);
---

<Base title={`${post.data.title} — introducing.news`} description={post.data.description} type="article">
  <article>
    <header class="post-head container">
      <div class="post-head__inner">
        <a class="post-head__back" href="/arquivo/">{t('post.back')}</a>
        <div class="post-head__title">
          <h1>{post.data.title}</h1>
        </div>
        <p class="post-head__lead">{post.data.description}</p>
        {
          author && (
            <div class="post-head__author-row">
              <div class="post-head__author">
                {author.data.photo ? (
                  <img
                    class="avatar avatar--photo"
                    src={author.data.photo}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="avatar" aria-hidden="true">
                    {initialsOf(author.data.name)}
                  </span>
                )}
                <p>{author.data.name}, {readingTime(post)} {t('post.minRead')}</p>
              </div>
              <div class="post-head__share">
                <a href={whatsappShare} target="_blank" rel="noopener" aria-label={t('post.share.whatsapp')}>
                  <img src="/icons/whatsapp.svg" width="18" height="18" alt="" aria-hidden="true" />
                </a>
                <a href={linkedinShare} target="_blank" rel="noopener" aria-label={t('post.share.linkedin')}>
                  <img src="/icons/linkedin-share.svg" width="18" height="18" alt="" aria-hidden="true" />
                </a>
                <a href={xShare} target="_blank" rel="noopener" aria-label={t('post.share.x')}>
                  <img src="/icons/x.svg" width="18" height="18" alt="" aria-hidden="true" />
                </a>
              </div>
            </div>
          )
        }
      </div>
    </header>

    <div class="post-main container">
      <div class="post-main__inner">
        <div class="post-cover">
          <Cover variant={post.data.cover} src={post.data.coverImage} />
        </div>

        <div class="prose">
          <Content />
        </div>

        <div class="post-subscribe">
          <div class="post-subscribe__text">
            <h2>{t('post.subscribe.title')}</h2>
            <p>{t('post.subscribe.body')}</p>
          </div>
          <SubscribeForm id="assinar-post" compact />
        </div>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="continue container">
        <h2>{t('post.continue')}</h2>
        <div class="continue__grid">
          {related.map((entry) => (
            <PostCard post={entry} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .post-head {
    padding-block: var(--space-16) var(--space-6);
  }

  .post-head__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--reading);
    margin-inline: auto;
  }

  .post-head__back {
    align-self: flex-start;
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .post-head__back:hover {
    color: var(--foreground);
  }

  .post-head__title {
    max-width: 620px;
  }

  .post-head h1 {
    font: 600 clamp(32px, 4.5vw, 44px) / 1.12 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .post-head__lead {
    font: 400 21px/1.65 var(--font-serif);
    color: var(--muted-foreground);
    max-width: 640px;
  }

  .post-head__author-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 40px;
  }

  .post-head__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .post-head__author p {
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
  }

  .post-head__share {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent-soft-foreground);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
  }

  .avatar--photo {
    object-fit: cover;
  }

  .post-main {
    padding-block: var(--space-6) var(--space-10);
  }

  .post-main__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: var(--reading);
    margin-inline: auto;
  }

  .post-cover {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .post-subscribe {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background: var(--muted);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .post-subscribe__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .post-subscribe h2 {
    font: 600 21px/1.3 var(--font-serif);
    letter-spacing: -0.005em;
  }

  .post-subscribe p {
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
  }

  .continue {
    padding-block: var(--space-10) var(--space-6);
  }

  .continue h2 {
    font: 600 28px/1.22 var(--font-serif);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-6);
  }

  .continue__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  .continue__grid > :global(.card) {
    max-width: 384px;
  }

  @media (min-width: 768px) {
    .post-subscribe {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .continue__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
