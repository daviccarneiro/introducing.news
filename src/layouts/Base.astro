---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { t } from '../copy';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Imagem de Open Graph/Twitter; sem ela, usa a padrão do site. */
  image?: string;
  noindex?: boolean;
}

const { title, description, type = 'website', image, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://introducing.news');
const canonical = new URL(Astro.url.pathname, site);
const pageTitle = title ?? t('meta.home.title');
const pageDescription = description ?? t('meta.home.description');
const ogImage = new URL(image ?? '/images/og-default.png', site).href;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    {
      gtmId && (
        <script
          is:inline
          set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});`}
        />
      )
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="introducing.news" href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="introducing.news" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400&family=Inter:wght@600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    {turnstileSiteKey && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}
  </head>
  <body>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    {/* Contador próprio do painel (/painel): sem cookie, só soma visitas do dia. */}
    <script is:inline>
      (function () {
        try {
          var r = document.referrer;
          var e = !r || new URL(r).host !== location.host;
          var u = new URLSearchParams(location.search).get('utm_source') || '';
          navigator.sendBeacon('/api/hit', JSON.stringify({ e: e, r: e ? r : '', u: u }));
        } catch (_) {}
      })();
    </script>
  </body>
</html>
