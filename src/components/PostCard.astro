---
import Badge from './Badge.astro';
import Cover from './Cover.astro';
import { categoryLabel, t } from '../copy';
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  cover?: Post['data']['cover'];
}

const { post, cover = post.data.cover } = Astro.props;
const href = `/arquivo/${post.id}/`;
---

<article class="card">
  <a class="card__cover" href={href} tabindex="-1" aria-hidden="true">
    <Cover variant={cover} src={post.data.coverImage} />
  </a>
  <div class="card__body">
    <p class="card__date meta">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
    </p>
    <div class="card__title-row">
      <h3 class="card__title"><a href={href}>{post.data.title}</a></h3>
      <Badge>{categoryLabel(post.data.category)}</Badge>
    </div>
    <p class="card__excerpt">{post.data.description}</p>
    <p class="card__foot">
      <img src="/icons/clock.svg" width="14" height="14" alt="" aria-hidden="true" />
      {readingTime(post)} {t('post.minRead')}
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .card__cover {
    display: block;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .card__title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .card__title {
    min-width: 0;
    font: 600 21px/1.3 var(--font-serif);
    letter-spacing: -0.005em;
  }

  .card__title a {
    text-decoration: none;
  }

  .card__title a:hover {
    color: var(--accent-soft-foreground);
  }

  .card__excerpt {
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
  }

  .card__foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: 400 13px/1.45 var(--font-sans);
    color: var(--muted-foreground);
    margin-top: auto;
  }
</style>
