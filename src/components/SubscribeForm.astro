---
import { t } from '../copy';

interface Props {
  id?: string;
  compact?: boolean;
}

const { id = 'assinar', compact = false } = Astro.props;
const inputId = `email-${id}-${compact ? 'c' : 'f'}`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form
  class:list={['subscribe', { 'subscribe--compact': compact }]}
  id={id}
  data-subscribe
  data-msg-sending={t('form.sending')}
  data-msg-success={t('form.success')}
  data-msg-error={t('form.error')}
  data-msg-invalid={t('form.invalid')}
  data-msg-network={t('form.network')}
  data-msg-consent={t('form.consentError')}
  novalidate
>
  <div class="subscribe__row">
    <label class="visually-hidden" for={inputId}>{t('form.placeholder')}</label>
    <input
      type="email"
      name="email"
      id={inputId}
      placeholder={t('form.placeholder')}
      autocomplete="email"
      required
    />
    <button type="submit">{t('form.button')}</button>
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span>{t('form.consent')}</span>
  </label>

  {
    turnstileSiteKey && (
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-language="pt-BR" />
    )
  }

  <p class="subscribe__status meta" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .subscribe {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    scroll-margin-top: var(--space-16);
  }

  .subscribe__row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }

  input[type='email'] {
    flex: 1 1 220px;
    min-width: 0;
    height: 48px;
    padding-inline: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--foreground);
    font: 400 15px/1 var(--font-sans);
  }

  input[type='email']::placeholder {
    color: var(--muted-foreground);
  }

  input[type='email']:focus {
    outline: none;
    border-color: var(--ring);
  }

  button {
    height: 48px;
    padding-inline: var(--space-5);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--primary-foreground);
    font: 500 15px/1 var(--font-sans);
    cursor: not-allowed;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .subscribe[data-ready] button {
    background: var(--accent);
    color: var(--accent-foreground);
    cursor: pointer;
  }

  .subscribe[data-ready] button:hover {
    background: var(--accent-600);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  button:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font: 400 13px/1.45 var(--font-sans);
    color: var(--muted-foreground);
    cursor: pointer;
    max-width: 460px;
  }

  .consent input {
    margin-top: 2px;
    accent-color: var(--accent-600);
  }

  .subscribe__status[data-state='ok'] {
    color: var(--accent-soft-foreground);
  }

  .subscribe__status[data-state='error'] {
    color: #b42318;
  }

  .subscribe--compact {
    width: 100%;
    max-width: 460px;
  }
</style>

<script>
  document.querySelectorAll('[data-subscribe]').forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;

    const consent = form.querySelector('input[name="consent"]');
    const syncButtonState = () => {
      if (consent instanceof HTMLInputElement && consent.checked) form.dataset.ready = 'true';
      else delete form.dataset.ready;
    };
    consent?.addEventListener('change', syncButtonState);
    syncButtonState();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('.subscribe__status');
      const button = form.querySelector('button');
      const input = form.querySelector('input[type="email"]');
      const turnstileInput = form.querySelector('[name="cf-turnstile-response"]');
      if (
        !(status instanceof HTMLElement) ||
        !(button instanceof HTMLButtonElement) ||
        !(input instanceof HTMLInputElement)
      ) {
        return;
      }

      const messages = {
        sending: form.dataset.msgSending ?? '…',
        success: form.dataset.msgSuccess ?? 'OK',
        error: form.dataset.msgError ?? 'Error',
        invalid: form.dataset.msgInvalid ?? 'Invalid',
        network: form.dataset.msgNetwork ?? 'Network',
        consent: form.dataset.msgConsent ?? 'Consent required',
      };

      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = messages.invalid;
        status.dataset.state = 'error';
        status.hidden = false;
        return;
      }
      if (consent instanceof HTMLInputElement && !consent.checked) {
        status.textContent = messages.consent;
        status.dataset.state = 'error';
        status.hidden = false;
        return;
      }

      button.disabled = true;
      const original = button.textContent;
      button.textContent = messages.sending;
      status.hidden = true;

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            consent: true,
            turnstileToken:
              turnstileInput instanceof HTMLInputElement ? turnstileInput.value : '',
          }),
        });
        if (response.ok) {
          form.reset();
          syncButtonState();
          status.textContent = messages.success;
          status.dataset.state = 'ok';
        } else {
          status.textContent = messages.error;
          status.dataset.state = 'error';
        }
      } catch {
        status.textContent = messages.network;
        status.dataset.state = 'error';
      } finally {
        status.hidden = false;
        button.disabled = false;
        button.textContent = original;
        const turnstile = (window as unknown as { turnstile?: { reset(): void } }).turnstile;
        turnstile?.reset();
      }
    });
  });
</script>
