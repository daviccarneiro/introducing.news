---
import { useTranslations } from '../i18n/ui';
import { getLocale } from '../i18n/utils';

interface Props {
  id?: string;
  compact?: boolean;
}

const { id = 'assinar', compact = false } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const inputId = `email-${id}-${compact ? 'c' : 'f'}`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form
  class:list={['subscribe', { 'subscribe--compact': compact }]}
  id={id}
  data-subscribe
  data-msg-sending={t('form.sending')}
  data-msg-success={t('form.success')}
  data-msg-error={t('form.error')}
  data-msg-invalid={t('form.invalid')}
  data-msg-network={t('form.network')}
  data-msg-consent={t('form.consentError')}
  novalidate
>
  <fieldset class="subscribe__lang">
    <legend class="visually-hidden">{t('form.lang.legend')}</legend>
    <label class="lang-pill">
      <input type="radio" name="locale" value="pt" checked={locale === 'pt'} />
      <span>Português</span>
    </label>
    <label class="lang-pill">
      <input type="radio" name="locale" value="en" checked={locale === 'en'} />
      <span>English</span>
    </label>
  </fieldset>

  <div class="subscribe__row">
    <label class="visually-hidden" for={inputId}>{t('form.placeholder')}</label>
    <input
      type="email"
      name="email"
      id={inputId}
      placeholder={t('form.placeholder')}
      autocomplete="email"
      required
    />
    <button type="submit">{t('form.button')}</button>
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span>{t('form.consent')}</span>
  </label>

  {
    turnstileSiteKey && (
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-theme="light"
        data-language={locale === 'pt' ? 'pt-BR' : 'en'}
      />
    )
  }

  <p class="subscribe__status meta" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .subscribe {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .subscribe__lang {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .lang-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font: 500 11px/1.2 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    cursor: pointer;
    background: var(--card);
  }

  .lang-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .lang-pill:has(input:checked) {
    border-color: var(--foreground);
    color: var(--foreground);
  }

  .subscribe__row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  input[type='email'] {
    flex: 1 1 220px;
    min-width: 0;
    height: 48px;
    padding-inline: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--foreground);
    font: 400 15px/1 var(--font-sans);
  }

  input[type='email']::placeholder {
    color: var(--muted-foreground);
  }

  input[type='email']:focus {
    outline: none;
    border-color: var(--ring);
  }

  button {
    height: 48px;
    padding-inline: var(--space-5);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-foreground);
    font: 500 15px/1 var(--font-sans);
    cursor: pointer;
  }

  button:hover {
    background: var(--accent-600);
  }

  button:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font: 400 13px/1.45 var(--font-sans);
    color: var(--muted-foreground);
    cursor: pointer;
    max-width: 460px;
  }

  .consent input {
    margin-top: 2px;
    accent-color: var(--accent-600);
  }

  .subscribe__status[data-state='ok'] {
    color: var(--accent-soft-foreground);
  }

  .subscribe__status[data-state='error'] {
    color: #b42318;
  }

  .subscribe--compact {
    width: 100%;
    max-width: 460px;
  }
</style>

<script>
  document.querySelectorAll('[data-subscribe]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const status = form.querySelector('.subscribe__status');
      const button = form.querySelector('button');
      const input = form.querySelector('input[type="email"]');
      const lang = form.querySelector('input[name="locale"]:checked');
      const consent = form.querySelector('input[name="consent"]');
      const turnstileInput = form.querySelector('[name="cf-turnstile-response"]');
      if (
        !(status instanceof HTMLElement) ||
        !(button instanceof HTMLButtonElement) ||
        !(input instanceof HTMLInputElement)
      ) {
        return;
      }

      const messages = {
        sending: form.dataset.msgSending ?? '…',
        success: form.dataset.msgSuccess ?? 'OK',
        error: form.dataset.msgError ?? 'Error',
        invalid: form.dataset.msgInvalid ?? 'Invalid',
        network: form.dataset.msgNetwork ?? 'Network',
        consent: form.dataset.msgConsent ?? 'Consent required',
      };

      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = messages.invalid;
        status.dataset.state = 'error';
        status.hidden = false;
        return;
      }
      if (consent instanceof HTMLInputElement && !consent.checked) {
        status.textContent = messages.consent;
        status.dataset.state = 'error';
        status.hidden = false;
        return;
      }

      button.disabled = true;
      const original = button.textContent;
      button.textContent = messages.sending;
      status.hidden = true;

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            locale: lang instanceof HTMLInputElement ? lang.value : 'pt',
            consent: true,
            turnstileToken:
              turnstileInput instanceof HTMLInputElement ? turnstileInput.value : '',
          }),
        });
        if (response.ok) {
          form.reset();
          status.textContent = messages.success;
          status.dataset.state = 'ok';
        } else {
          status.textContent = messages.error;
          status.dataset.state = 'error';
        }
      } catch {
        status.textContent = messages.network;
        status.dataset.state = 'error';
      } finally {
        status.hidden = false;
        button.disabled = false;
        button.textContent = original;
        const turnstile = (window as unknown as { turnstile?: { reset(): void } }).turnstile;
        turnstile?.reset();
      }
    });
  });
</script>
