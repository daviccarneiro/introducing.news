---
import { t } from '../copy';
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/" aria-label="introducing.news">
      <img src="/icons/sparkle.svg" width="20" height="20" alt="" aria-hidden="true" />
      <span class="logo__mark">introducing<span class="logo__tld">.news</span></span>
    </a>

    <div class="header__actions">
      <a class="button" href="/#assinar">{t('nav.subscribe')}</a>
      <nav class="nav" aria-label={t('nav.list')}>
        <a href="/arquivo/">{t('nav.list')}</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 72px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .logo__mark {
    font: 600 18px/1 'Inter', var(--font-sans);
    letter-spacing: -0.01em;
  }

  .logo__tld {
    color: var(--muted-foreground);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav {
    display: none;
  }

  .nav a {
    font: 500 14px/1 var(--font-sans);
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--foreground);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-foreground);
    font: 500 14px/1.4 var(--font-sans);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .button:hover {
    background: var(--accent-600);
  }

  @media (min-width: 768px) {
    .nav {
      display: block;
    }
  }
</style>
