---
const nav = [
  { label: 'Ensaios', href: '/ensaios/' },
  { label: 'Sobre', href: '/#sobre' },
  { label: 'Arquivo', href: '/ensaios/' },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/" aria-label="introducing.news — início">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 2 C 13.2 8.4 15.6 10.8 22 12 C 15.6 13.2 13.2 15.6 12 22 C 10.8 15.6 8.4 13.2 2 12 C 8.4 10.8 10.8 8.4 12 2 Z"
          stroke="#F6821F"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
      <span class="logo__mark">introducing<span class="logo__tld">.news</span></span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="actions">
      <a class="icon-link" href="https://www.linkedin.com/in/daviccarneiro/" target="_blank" rel="noopener" aria-label="LinkedIn de Davi Carneiro">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B0B0C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect width="4" height="12" x="2" y="9"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
      <a class="button button--primary" href="/#assinar">Assinar</a>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 72px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .logo__mark {
    font: 600 18px/1 var(--font-sans);
    letter-spacing: -0.01em;
  }

  .logo__tld {
    color: var(--muted-foreground);
  }

  .nav {
    display: none;
    gap: var(--space-8);
  }

  .nav a {
    font: 500 14px/1 var(--font-sans);
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--foreground);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .icon-link {
    display: inline-flex;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 40px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
    font: 500 14px/1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    border: 0;
  }

  .button--primary {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  @media (min-width: 768px) {
    .nav {
      display: flex;
    }
  }
</style>
