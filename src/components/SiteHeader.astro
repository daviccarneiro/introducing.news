---
import { paths } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getLocale } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href={paths.home(locale)} aria-label="introducing.news">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 2 C 13.2 8.4 15.6 10.8 22 12 C 15.6 13.2 13.2 15.6 12 22 C 10.8 15.6 8.4 13.2 2 12 C 8.4 10.8 10.8 8.4 12 2 Z"
          stroke="#F6821F"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
      <span class="logo__mark">introducing<span class="logo__tld">.news</span></span>
    </a>

    <a class="button" href={`${paths.home(locale)}#assinar`}>{t('nav.subscribe')}</a>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 72px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .logo__mark {
    font: 600 18px/1 var(--font-sans);
    letter-spacing: -0.01em;
  }

  .logo__tld {
    color: var(--muted-foreground);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--primary-foreground);
    font: 500 14px/1 var(--font-sans);
    text-decoration: none;
  }
</style>
