---
import { paths } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getLocale } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="logo" href={paths.home(locale)} aria-label="introducing.news">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 2 C 13.2 8.4 15.6 10.8 22 12 C 15.6 13.2 13.2 15.6 12 22 C 10.8 15.6 8.4 13.2 2 12 C 8.4 10.8 10.8 8.4 12 2 Z"
              stroke="#F6821F"
              stroke-width="2"
              stroke-linejoin="round"></path>
          </svg>
          <span class="logo__mark">introducing<span class="logo__tld">.news</span></span>
        </a>
        <p>{t('footer.blurb')}</p>
        <div class="footer__social">
          <a href="https://github.com/daviccarneiro" target="_blank" rel="noopener" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B6B76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/daviccarneiro/" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B6B76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href={paths.rss(locale)} aria-label="RSS">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B6B76" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer__aside">
        <a href={paths.archive(locale)}>{t('nav.list')}</a>
        <a class="button" href={`${paths.home(locale)}#assinar`}>{t('nav.subscribe')}</a>
      </div>
    </div>

    <div class="footer__divider"></div>

    <div class="footer__bottom">
      <p class="meta">© {year} introducing.news</p>
      <p class="meta">
        {t('footer.madeBy')}
        <a href="https://www.linkedin.com/in/daviccarneiro/" target="_blank" rel="noopener">Davi Carneiro</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-16) var(--space-10);
    background: var(--background);
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    justify-content: space-between;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 320px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .logo__mark {
    font: 600 18px/1 var(--font-sans);
    letter-spacing: -0.01em;
  }

  .logo__tld {
    color: var(--muted-foreground);
  }

  .footer__brand p {
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
  }

  .footer__social {
    display: flex;
    gap: var(--space-4);
  }

  .footer__aside {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .footer__aside a {
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .footer__aside a:hover {
    color: var(--foreground);
  }

  .footer__aside .button {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding-inline: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--foreground);
    font: 500 14px/1 var(--font-sans);
  }

  .footer__divider {
    height: 1px;
    background: var(--border);
    margin-block: var(--space-10);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .footer__bottom a {
    color: var(--foreground);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
  }

  @media (min-width: 768px) {
    .footer__top {
      flex-direction: row;
      align-items: flex-start;
    }
  }
</style>
