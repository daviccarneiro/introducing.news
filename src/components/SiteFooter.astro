---
import { t } from '../copy';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="logo" href="/" aria-label="introducing.news">
          <img src="/icons/sparkle.svg" width="20" height="20" alt="" aria-hidden="true" />
          <span class="logo__mark">introducing<span class="logo__tld">.news</span></span>
        </a>
        <p class="footer__blurb">{t('footer.blurb')}</p>
        <div class="footer__social">
          <a href="https://www.linkedin.com/in/daviccarneiro/" target="_blank" rel="noopener" aria-label="LinkedIn">
            <img src="/icons/linkedin.svg" width="18" height="18" alt="" aria-hidden="true" />
          </a>
          <a href="/rss.xml" aria-label="RSS">
            <img src="/icons/rss.svg" width="18" height="18" alt="" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="footer__aside">
        <nav class="footer__links" aria-label="Navegação do rodapé">
          <a href="/arquivo/">{t('nav.list')}</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <a class="button" href="/#assinar">{t('nav.subscribe')}</a>
      </div>
    </div>

    <div class="footer__divider"></div>

    <div class="footer__bottom">
      <p class="footer__legal">© {year} introducing.news</p>
      <p class="footer__legal">
        {t('footer.madeBy')}{' '}
        <a href="https://davi.cc" target="_blank" rel="noopener">Davi Carneiro</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--background);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding-block: var(--space-16) var(--space-10);
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    justify-content: space-between;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 320px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .logo__mark {
    font: 600 18px/1 'Inter', var(--font-sans);
    letter-spacing: -0.01em;
  }

  .logo__tld {
    color: var(--muted-foreground);
  }

  .footer__blurb {
    font: 400 14px/1.5 var(--font-sans);
    color: var(--muted-foreground);
  }

  .footer__social {
    display: flex;
    gap: var(--space-4);
  }

  .footer__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__links a {
    font: 400 13px/1.4 var(--font-mono);
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--foreground);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--foreground);
    font: 500 14px/1.4 var(--font-sans);
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--border-strong);
  }

  .footer__divider {
    height: 1px;
    background: var(--border);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .footer__legal {
    font: 400 13px/1.4 var(--font-mono);
    color: var(--muted-foreground);
  }

  .footer__legal a {
    color: var(--foreground);
    text-decoration: none;
    border-bottom: 1.5px solid var(--accent);
  }

  @media (min-width: 768px) {
    .footer__top {
      flex-direction: row;
      align-items: flex-start;
    }

    .footer__aside {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-24);
    }
  }
</style>
