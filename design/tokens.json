{
  "$comment": "Tokens do design da introducing.news — espelho de src/styles/tokens.css e do arquivo Figma 'introducing.news — Design'. Cores em hex. Tipografia em px (CSS na escala 1rem = 16px).",
  "color": {
    "primitives": {
      "paper": "#FFFFFF",
      "ink": {
        "50": "#F9F9FB",
        "100": "#F2F2F5",
        "200": "#E4E4E9",
        "300": "#C9C9D1",
        "400": "#9A9AA4",
        "500": "#6B6B76",
        "600": "#4B4B55",
        "700": "#33333A",
        "800": "#1F1F23",
        "900": "#141417",
        "950": "#0B0B0C"
      },
      "accent": {
        "50": "#FFF6ED",
        "100": "#FDEBD7",
        "500": "#F6821F",
        "600": "#E06C0F",
        "700": "#A63E0A"
      }
    },
    "semantic": {
      "background": { "value": "#FFFFFF", "css": "--background", "alias": "paper", "usage": "fundo das páginas" },
      "foreground": { "value": "#0B0B0C", "css": "--foreground", "alias": "ink/950", "usage": "texto principal" },
      "card": { "value": "#FFFFFF", "css": "--card", "alias": "paper", "usage": "fundo de cartões e campos" },
      "muted": { "value": "#F9F9FB", "css": "--muted", "alias": "ink/50", "usage": "faixas e blocos de destaque suave" },
      "muted-foreground": { "value": "#6B6B76", "css": "--muted-foreground", "alias": "ink/500", "usage": "texto secundário, metadados" },
      "border": { "value": "#E4E4E9", "css": "--border", "alias": "ink/200", "usage": "bordas e divisores" },
      "border-strong": { "value": "#C9C9D1", "css": "--border-strong", "alias": "ink/300", "usage": "bordas em hover/foco de controles" },
      "primary": { "value": "#0B0B0C", "css": "--primary", "alias": "ink/950", "usage": "superfícies escuras" },
      "primary-foreground": { "value": "#FFFFFF", "css": "--primary-foreground", "alias": "paper", "usage": "texto sobre primary" },
      "accent": { "value": "#F6821F", "css": "--accent", "alias": "accent/500", "usage": "CTA, realces, marca" },
      "accent-foreground": { "value": "#0B0B0C", "css": "--accent-foreground", "alias": "ink/950", "usage": "texto sobre accent" },
      "accent-soft": { "value": "#FFF6ED", "css": "--accent-soft", "alias": "accent/50", "usage": "fundos suaves de acento (avatar, selos)" },
      "accent-soft-foreground": { "value": "#A63E0A", "css": "--accent-soft-foreground", "alias": "accent/700", "usage": "texto de acento sobre fundo claro" },
      "link": { "value": "#A63E0A", "css": "--link", "alias": "accent/700", "usage": "links no corpo do texto" },
      "ring": { "value": "#0B0B0C", "css": "--ring", "alias": "ink/950", "usage": "foco visível" },
      "code-bg": { "value": "#0B0B0C", "css": "--code-bg", "alias": "ink/950", "usage": "fundo de blocos de código" },
      "code-fg": { "value": "#F2F2F5", "css": "--code-fg", "alias": "ink/100", "usage": "texto de blocos de código" }
    },
    "gradient": { "$comment": "A marca não usa gradientes. Use apenas cores sólidas." }
  },
  "typography": {
    "families": {
      "serif": { "name": "Source Serif 4", "fallback": "Georgia, 'Times New Roman', serif", "file": "design/fonts/SourceSerif4[opsz,wght].ttf", "fileItalic": "design/fonts/SourceSerif4-Italic[opsz,wght].ttf", "usage": "títulos e leitura longa" },
      "sans": { "name": "Geist", "fallback": "system-ui, -apple-system, sans-serif", "file": "design/fonts/Geist[wght].ttf", "usage": "interface, textos curtos e metadados" },
      "mono": { "name": "JetBrains Mono", "fallback": "ui-monospace, Menlo, monospace", "file": "design/fonts/JetBrainsMono[wght].ttf", "usage": "rótulos, datas do rodapé e numerais" },
      "code": { "name": "Geist Mono", "fallback": "ui-monospace, Menlo, monospace", "file": "design/fonts/GeistMono[wght].ttf", "usage": "código" },
      "logo": { "name": "Inter", "fallback": "system-ui, sans-serif", "file": "design/fonts/Inter[opsz,wght].ttf", "usage": "apenas o logotipo" }
    },
    "scale": [
      { "figma": "Display/XL", "family": "serif", "weight": 600, "sizePx": 64, "lineHeight": 1.05, "letterSpacing": "-0.015em", "usage": "H1 da home (clamp 40→64px)" },
      { "figma": "Display/LG", "family": "serif", "weight": 600, "sizePx": 56, "lineHeight": 1.08, "letterSpacing": "-0.015em", "usage": "títulos grandes de apoio" },
      { "figma": "Display/MD", "family": "serif", "weight": 600, "sizePx": 44, "lineHeight": 1.12, "letterSpacing": "-0.015em", "usage": "H1 do post e do arquivo (clamp 32→44px)" },
      { "figma": "Heading/H1", "family": "serif", "weight": 600, "sizePx": 40, "lineHeight": 1.15, "letterSpacing": "-0.015em", "usage": "títulos intermediários" },
      { "figma": "Heading/H2", "family": "serif", "weight": 600, "sizePx": 28, "lineHeight": 1.22, "letterSpacing": "-0.01em", "usage": "títulos de seção (\"Última edição\", \"Perguntas frequentes\")" },
      { "figma": "Heading/H3", "family": "serif", "weight": 600, "sizePx": 21, "lineHeight": 1.3, "letterSpacing": "-0.005em", "usage": "títulos de cartão e de subtítulos" },
      { "figma": "Heading/H4", "family": "sans", "weight": 500, "sizePx": 17, "lineHeight": 1.4, "letterSpacing": "0", "usage": "pergunta do FAQ, nome do autor" },
      { "figma": "Body/Serif-LG", "family": "serif", "weight": 400, "sizePx": 21, "lineHeight": 1.65, "letterSpacing": "0", "usage": "lead do destaque" },
      { "figma": "Body/Serif", "family": "serif", "weight": 400, "sizePx": 18, "lineHeight": 1.75, "letterSpacing": "0", "usage": "corpo do artigo" },
      { "figma": "Quote/Serif", "family": "serif", "weight": 400, "italic": true, "sizePx": 24, "lineHeight": 1.5, "letterSpacing": "-0.005em", "usage": "citações (barra accent à esquerda)" },
      { "figma": "Body/Sans", "family": "sans", "weight": 400, "sizePx": 16, "lineHeight": 1.6, "letterSpacing": "0", "usage": "texto de interface e subtítulos" },
      { "figma": "Body/Sans-SM", "family": "sans", "weight": 400, "sizePx": 14, "lineHeight": 1.5, "letterSpacing": "0", "usage": "resumos de cartões" },
      { "figma": "Body/Sans-XS", "family": "sans", "weight": 400, "sizePx": 13, "lineHeight": 1.45, "letterSpacing": "0", "usage": "texto de consentimento" },
      { "figma": "Meta/Sans", "family": "sans", "weight": 400, "sizePx": 13, "lineHeight": 1.4, "letterSpacing": "0", "usage": "datas e metadados" },
      { "figma": "Label/Mono", "family": "mono", "weight": 500, "sizePx": 11, "lineHeight": 1.4, "letterSpacing": "0.08em", "textCase": "uppercase", "usage": "rótulos (\"EDIÇÃO #1\", \"COMPARTILHE\")" },
      { "figma": "Code/Mono", "family": "code", "weight": 400, "sizePx": 14, "lineHeight": 1.7, "letterSpacing": "0", "usage": "blocos de código" },
      { "figma": "Button/Sans", "family": "sans", "weight": 500, "sizePx": 14, "lineHeight": 1.4, "letterSpacing": "0", "usage": "botões (variante lg usa 15px)" },
      { "figma": "Nav/Sans", "family": "sans", "weight": 500, "sizePx": 14, "lineHeight": 1, "letterSpacing": "0", "usage": "navegação do cabeçalho" },
      { "figma": "Footer/Mono", "family": "mono", "weight": 400, "sizePx": 13, "lineHeight": 1.4, "letterSpacing": "0", "usage": "links e © do rodapé" },
      { "figma": "— (logo)", "family": "logo", "weight": 600, "sizePx": 18, "lineHeight": 1, "letterSpacing": "-0.01em", "usage": "logotipo; \".news\" em muted-foreground" }
    ]
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px",
    "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px", "32": "128px"
  },
  "radius": {
    "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgb(9 9 11 / 0.05)",
    "sm": "0 1px 3px rgb(9 9 11 / 0.06), 0 1px 2px rgb(9 9 11 / 0.04)",
    "md": "0 4px 12px rgb(9 9 11 / 0.08), 0 1px 2px rgb(9 9 11 / 0.04)"
  },
  "layout": {
    "container": "1440px",
    "reading": "720px",
    "pagePadding": { "mobile": "24px", "tablet": "48px", "desktop": "128px" },
    "headerHeight": "72px",
    "controls": { "md": "40px", "lg": "48px", "input": "44px" },
    "coverAspect": "16:9 (1200×675)"
  }
}
